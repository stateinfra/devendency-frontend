# Database (PostgreSQL)
# 로컬 docker-compose 사용 시 그대로 두어도 됩니다.
DATABASE_URL="postgresql://devlog:devlog@localhost:5432/devlog"
DIRECT_URL="postgresql://devlog:devlog@localhost:5432/devlog"

# Auth.js — 아무 랜덤 문자열. `openssl rand -base64 32`로 생성 권장.
AUTH_SECRET=""

# OAuth (선택)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 공개 URL — 프로덕션에서는 실제 도메인으로 교체
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# S3 호환 스토리지 (이미지 업로드) — Supabase S3, AWS S3, MinIO 등
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# 이메일 발송 (비밀번호 재설정 등)
RESEND_API_KEY=""

# Vercel 커스텀 도메인 연동 (사용 시에만)
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
